# copie este arquivo para ".env" e preencha com valores reais

# ex: postgresql://usuario:senha@localhost:5432/plataforma_cursos
# pra começar rápido sem instalar Postgres localmente, dá pra usar um banco
# gratuito no Neon (neon.tech) ou Supabase (supabase.com) e colar a connection string aqui
DATABASE_URL=

# Domínio final do site, COM https e sem barra no fim (ex: https://dmproject.com.br).
# Alimenta OpenGraph, canonical, sitemap.xml e robots.txt. Sem isso em produção
# o site anuncia "localhost:3000" pro Google e pro WhatsApp.
# Na Vercel, previews caem no VERCEL_URL automaticamente — ver src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Painel Hotmart → Ferramentas → Webhook → aba Autenticação
HOTMART_HOTTOK=

# segredo pra assinar o cookie de sessão (JWT). Gere um valor aleatório longo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# protege as rotas /api/cron/*. Na Vercel, defina essa env var e a plataforma
# manda "Authorization: Bearer <CRON_SECRET>" automaticamente nos cron jobs.
# Self-hosted: chame as rotas com esse mesmo header (ou ?secret=<valor>).
CRON_SECRET=
